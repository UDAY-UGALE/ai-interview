# Copy to .env for local development, or paste these as environment
# variables in your cloud provider's dashboard. NEVER commit a filled-in
# .env -- it is gitignored, and it must stay that way.
#
# Every value here is read by app/core/config.py. Anything you leave out
# falls back to the default defined there, so a working local setup only
# really needs GROQ_API_KEY.

# ============================================================
# Secrets
# ============================================================
# The only ones that cost money or grant access. On a deployed backend
# these belong in the platform's secret store (Render env vars, AWS
# Secrets Manager, Azure Key Vault) -- never in an image, never in git.

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Shared secret every client must present once the backend is reachable
# from the internet. Leave EMPTY for local development (server bound to
# 127.0.0.1); set it to a long random string on any deployment.
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
APP_AUTH_TOKEN=

# ============================================================
# Deployment / portability
# ============================================================

# Reported by GET /version. Set from CI or your platform's commit variable
# if you want it to track releases.
APP_VERSION=0.1.0

# Comma-separated browser origins allowed to call the HTTP API.
# Empty = no CORS middleware, which is correct for the desktop client
# (not a browser, sends no Origin). Only needed if a web page calls the
# backend. "*" is refused while APP_AUTH_TOKEN is set.
CORS_ALLOW_ORIGINS=

# Per-session JSONL transcripts. Turn OFF on any host with an ephemeral or
# read-only filesystem (Render free, Fargate, Container Apps) where the
# files are lost on restart anyway.
SESSION_LOG_ENABLED=true
# Empty = <repo>/logs. Point at a mounted volume in a container.
SESSION_LOG_DIR=

# memory = single instance, no external dependency (the default, and what
# Render free should run). redis = required BEFORE you run more than one
# instance or worker, because the session context and the answer hub are
# in-process otherwise.
SESSION_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Speech to text
# ============================================================
# groq | openai | faster_whisper | nvidia
# faster_whisper runs the model in-process (1-2GB RAM): a local/dev option,
# not something to enable on a shared or free-tier deployment.
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
STT_TIMEOUT_SECONDS=12
STT_NO_SPEECH_THRESHOLD=
STT_DROP_CONFIDENCE_THRESHOLD=
# true = call primary AND fallback concurrently, take the first. Cuts
# worst-case latency, doubles your request rate against both providers.
STT_RACE_PROVIDERS=false
STT_FALLBACK_ENABLED=true

# Only for STT_PROVIDER=nvidia
# ---- Deepgram (STT_PROVIDER=deepgram) --------------------------------
# Nova-3 behind the same STT interface as Whisper. Switching STT_PROVIDER to
# deepgram changes the recognizer and nothing else -- VAD, quality filter,
# question gate and answer path are untouched. Whisper stays available and
# is used automatically as the fallback when Deepgram fails, so a migration
# does not have to be all-or-nothing.
#
# Run client/test_stt_comparison.py before switching: the point of keeping
# both is to make that decision on measured evidence.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_TIMEOUT_SECONDS=12
# Session vocabulary sent as Deepgram keyterms. Counted in TERMS, not bytes,
# which is why the resume can no longer be truncated away by a long JD the
# way it was in Whisper's ~850-byte prompt.
DEEPGRAM_KEYTERM_LIMIT=100
# Live socket + Deepgram's own endpointing, alongside the existing VAD.
# OFF until the comparison has actually been run.
DEEPGRAM_STREAMING=false
DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_ENDPOINTING_MS=400
DEEPGRAM_UTTERANCE_END_MS=1000

NVIDIA_STT_MODE=
NVIDIA_RIVA_SERVER=
NVIDIA_STT_MODEL=
NVIDIA_STT_LANGUAGE=

# Only for STT_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=
FASTER_WHISPER_DEVICE=
FASTER_WHISPER_COMPUTE_TYPE=
FASTER_WHISPER_CPU_THREADS=

# ============================================================
# Answers
# ============================================================
# groq | openai | anthropic | deepseek
ANSWER_PROVIDER=groq
ANSWER_MODEL=openai/gpt-oss-120b
ANSWER_MAX_TOKENS=
ANSWER_TEMPERATURE=

# Screenshot analysis (/analyze-screen)
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.6-27b

# ============================================================
# Audio, VAD and segmentation
# ============================================================
# These must stay aligned with the client's --samplerate / --chunk-ms.
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=20

# energy = pure Python, installs anywhere. webrtc needs a compiled wheel.
VAD_BACKEND=energy
VAD_MODE=
# FLOOR for the trigger level, not the trigger itself. At 500 any speech
# below -36 dBFS was never detected at all on a quiet line. Only safe
# together with VAD_CALIBRATION_MS -- see app/core/config.py.
VAD_ENERGY_THRESHOLD=150
VAD_ADAPTIVE_THRESHOLD=true
# Measure the line for this long at connect before reporting any speech,
# so the noise floor comes from real audio instead of a seeded constant.
VAD_CALIBRATION_MS=1000
VAD_ONSET_FRAMES=
VAD_PREROLL_MS=

SEGMENT_MIN_SECONDS=
SEGMENT_MAX_SECONDS=
SEGMENT_END_SILENCE_MS=420
SEGMENT_MIN_SPEECH_MS=
SEGMENT_CARRYOVER_MS=

# ============================================================
# Question gating
# ============================================================
QUESTION_DEBOUNCE_MS=180
QUESTION_MAX_WAIT_SECONDS=
QUESTION_SOFT_WAIT_SECONDS=
QUESTION_SOFT_WAIT_WORD_LIMIT=
UTTERANCE_MERGE_GAP_SECONDS=
FAST_INTENT_TIMEOUT_SECONDS=1.2

# ---- Session vocabulary ----------------------------------------------
# Terms pulled from the resume/JD/history and used to bias the recognizer
# and to gate transcript normalization. Replaces pasting resume prose into
# the STT prompt, which measured 1,114 bytes into an 850-byte cap and
# silently dropped the entire resume whenever a JD was loaded.
SESSION_VOCABULARY_ENABLED=true
SESSION_VOCABULARY_MAX_TERMS=120

# ---- Transcript normalization ----------------------------------------
# Repairs known mis-transcriptions (Rack->RAG, red is->Redis, doctor->Docker)
# BEFORE the question gate. Never unconditional: a substitution needs the
# canonical term to appear in this session's vocabulary AND the heard form
# not to, so a Ruby interview's genuine "Rack" is left alone. Every
# substitution and every declined candidate is logged.
TRANSCRIPT_NORMALIZATION_ENABLED=true
# Detect and log without applying -- use this to see what it WOULD do on a
# real interview before letting it change what reaches the LLM.
TRANSCRIPT_NORMALIZATION_LOG_ONLY=false

# ---- Question completion ---------------------------------------------
# Grace given ONLY to speech that is genuinely unfinished ("can you
# explain...", "what challenges did you"). A question that looks finished is
# released with no wait at all -- that is what protects the measured 182ms
# p50 from last spoken word to LLM call. This is NOT a global delay.
CONTINUATION_WINDOW_MS=350
# How long after an answer starts a continuation can still arrive and MERGE
# with it rather than becoming a second answer.
SUPERSEDE_WINDOW_SECONDS=4.0
# Treat "actually" / "sorry, I mean" / "I said ..." as REPLACING the question
# just asked, cancelling its answer if one is streaming.
CORRECTION_HANDLING_ENABLED=true

# ---- Candidate context ------------------------------------------------
# How many characters of candidate context (resume + JD + project context +
# notes) may be sent with ONE question. A rate-limit control, not a quality
# one: all of it is re-sent on every question and providers meter tokens per
# minute (~4 characters per token). The default caps this block at ~1,300
# tokens on top of the ~1,750-token system prompt; measured end to end with
# two fully-filled projects that is ~2,400 tokens per question, or about 3
# questions a minute against an 8,000 TPM limit. Raise it if your plan has headroom -- more grounded
# context makes answers strictly better. Spent in priority order (project
# context, resume, experience notes, JD, stories, notes), with floors
# reserved for the resume and JD so a long project blob cannot evict them.
# CANDIDATE_CONTEXT_CHAR_BUDGET=5200

# Ceiling on one uploaded resume/JD/project-notes document. Project notes are
# text; past this it is a slide deck or a document of screenshots, neither of
# which extracts usefully.
# CONTEXT_UPLOAD_MAX_BYTES=8000000
