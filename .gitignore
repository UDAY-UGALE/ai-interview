.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/


# Session transcripts: debug output, regenerated on every run, and wiped on
# every redeploy in a container anyway. Already-tracked ones stay tracked --
# `git rm --cached logs/*.jsonl` if you want them out of history going forward.
logs/*.jsonl

# Client build artifacts (scripts/build_client.ps1)
build/
dist/

# Generated STT test fixtures and comparison output. The corpus is rendered
# on demand (client/test_stt_comparison.py --generate) and is ~3MB of WAV;
# the JSON is a measurement of one run, not source.
client/stt_corpus/
stt_comparison*.json
